[user]
    name = Laurent Lanteigne
    email = laurent.lanteigne@gmail.com

[init]
    defaultBranch = master

[core]
	excludesfile = ~/.gitignore

[github]
	user = "lanteignel93"

# Always use SSH for GitHub. Host `github.com` maps to the personal key
# (id_ed25519_personal -> lanteignel93); see ~/.ssh/config.
[url "git@github.com:"]
    insteadOf = https://github.com/

# Work identity for repos under ~/work/. The included file lives in the
# private dotfiles repo — this is only a path reference, no work details here.
# Keep last: later includes override earlier settings.
[includeIf "gitdir:~/work/"]
    path = ~/.gitconfig.work
